<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>MyFirstApp</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial;
            background: #f4f6f8;
        }

        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 230px;
            background: #222;
            color: white;
            padding: 20px;
        }

        .main {
            flex: 1;
        }

        .header {
            background: white;
            padding: 20px;
            border-bottom: 1px solid #ddd;
        }

        .content {
            padding: 30px;
        }

        .footer {
            background: white;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #ddd;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 12px;
            margin-bottom: 5px;
        }

        .sidebar a:hover {
            background: #444;
        }
    </style>
</head>

<body>

    <div class="dashboard">

        <aside class="sidebar">
            <partial name="_Sidebar" />
        </aside>

        <div class="main">

            <header class="header">
                <partial name="_Header" />
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="footer">
                <partial name="_Footer" />
            </footer>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>