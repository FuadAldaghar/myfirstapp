@model MyFirstApp.Models.Project

<h1>Create Project</h1>

<form asp-controller="Home"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <!-- Name -->
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />

        <span asp-validation-for="Name"></span>
    </div>

    <!-- Description -->
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>

        <span asp-validation-for="Description"></span>
    </div>

    <!-- GitHub URL -->
    <div>
        <label asp-for="GitHubUrl"></label>
        <input asp-for="GitHubUrl" />

        <span asp-validation-for="GitHubUrl"></span>
    </div>

    <!-- Category -->
    <div>
        <label asp-for="Category"></label>

        <select asp-for="Category">
            <option value="">-- Select Category --</option>
            <option value="Web Development">Web Development</option>
            <option value="Mobile Development">Mobile Development</option>
            <option value="Desktop Development">Desktop Development</option>
            <option value="AI">AI</option>
            <option value="IoT">IoT</option>
        </select>
    </div>

    <!-- IsPublic -->
    <div>
        <label>
            <input asp-for="IsPublic" />
            Public Project
        </label>
    </div>

    <!-- Project Type -->
    <div>
        <p>Project Type</p>

        <label>
            <input asp-for="ProjectType"
                   type="radio"
                   value="Personal" />
            Personal
        </label>

        <label>
            <input asp-for="ProjectType"
                   type="radio"
                   value="Academic" />
            Academic
        </label>

        <label>
            <input asp-for="ProjectType"
                   type="radio"
                   value="Commercial" />
            Commercial
        </label>
    </div>

    <!-- License -->
    <div>
        <label asp-for="License"></label>

        <select asp-for="License">
            <option value="">-- Select License --</option>
            <option value="MIT">MIT</option>
            <option value="Apache 2.0">Apache 2.0</option>
            <option value="GPL">GPL</option>
            <option value="None">None</option>
        </select>
    </div>
    <div>
        <label asp-for="TechnologiesCount"></label>
        <input asp-for="TechnologiesCount" />
        <span asp-validation-for="TechnologiesCount"></span>
    </div>

    <!-- Image -->
    <!-- <div>
        <label>Project Image</label>

        <input type="file"
               name="image" />
    </div> -->

    <!-- Submit -->
    <div>
        <button type="submit">
            Create Project
        </button>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



