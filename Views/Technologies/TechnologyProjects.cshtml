@model IEnumerable<MyFirstApp.Models.Project>
<h1>المشاريع</h1>
@if(Model.Any()){
    <table border=2>
        <thead>
            <tr>
                <th>الاسم</th>
                <th>التصنيف</th>
                <th>التقنيات</th>
                <th>العميل</th>
                <th>تاريخ البدء</th>
                <th>تاريخ الانتهاء</th>
                <th>الميزانية</th>
                <th>الحاله</th>
                <th>اجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var project in Model)
            {
                <tr>
                    <td>
                        @project.Name
                    </td>

                    <td>
                        @project.Category?.Name
                    </td>

                    <td>
                        @foreach(var technology in project.Technologies)
                        {
                            <span>@technology.Name</span>
                            <br />
                        }
                    </td>

                    <td>
                        @project.ProjectDetails?.Client
                    </td>

                    <td>
                        @project.ProjectDetails?.StartDate
                    </td>

                    <td>
                        @project.ProjectDetails?.EndDate
                    </td>

                    <td>
                        @project.ProjectDetails?.Budget
                    </td>

                    <td>
                        @(project.IsPublic ? "YES" : "NO")
                    </td>

                    <td>
                        <a asp-action="Details" asp-route-id="@project.Id">
                            DETAILS
                        </a>

                        |

                        <a asp-action="Edit" asp-route-id="@project.Id">
                            EDIT
                        </a>

                        |

                        <a asp-action="Delete" asp-route-id="@project.Id">
                            DELETE
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>لا توجد مشاريع لهذه التقنية</p>
}