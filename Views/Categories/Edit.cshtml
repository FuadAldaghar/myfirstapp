@model MyFirstApp.Models.Category

<h1>Edit Category</h1>
<form asp-controller="Categories" asp-action="Edit" method="post">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name"/>
        <span asp-validation-for="Name"></span>
    </div>
    <button type="submit" >Edit</button>
</form>