@model IEnumerable<MyFirstApp.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<h1>PROJECTS</h1>

<p>
    <a asp-controller="Projects" asp-action="Create">
        ADD PROJECT
    </a>
</p>

<table border=2   >
    <thead>
        <tr>
            <th>لاسم</th>
            <th>الوصف</th>
            <th>فئة</th>
            <th>النوع</th>
            <th>رابطgithub</th>
             <th>الترخيص</th>
            <th>التقنيات المستخدمة</th>
            <th>العميل</th>
            <th>تاريخ البدء</th>
            <th>تاريخ الانتهاء</th>
            <th>الميزانية</th>
            <th>الحالة</th>
            <th>ACTIONS</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>
                    @project.Name
                </td>

                <td>
                    @project.Description
                </td>

                <td>
                    @project.Category?.Name
                </td>
                <td>
                 @project.ProjectType
                 </td>
                 <td>
                 @project.GitHubUrl
                 </td>
                  <td>
                 @project.License
                 </td>
                <td>
                    @foreach (var technology in project.Technologies)
                    {
                        <span>@technology.Name</span>
                        <br />
                    }
                </td>

                <td>
                    @project.ProjectDetails?.Client
                </td>

                <td>
                    @project.ProjectDetails?.StartDate
                </td>

                <td>
                    @project.ProjectDetails?.EndDate
                </td>

                <td>
                    @Math.Round((decimal)project.ProjectDetails?.Budget,2)
                </td>

                <td>
                    @(project.IsPublic ? "عام" : "خاص")
                </td>

                <td>
                    <a asp-action="Details" 
                       asp-route-id="@project.Id">
                        DETAILS
                    </a>

                    |

                    <a asp-action="Edit"  
                       asp-route-id="@project.Id">
                        EDIT
                    </a>

                    
                    <form asp-action="Delete" asp-controller="Projects" method="post">
                    <input type="hidden" name="id" value="@project.Id" />

                        <button type="submit"
                        onclick="return confirm('هل انت متاكد من حذف المشروع')">
                        حذف
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>